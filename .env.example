# Names only. Set values in the Netlify and Convex dashboards. Do not commit secrets.
# .gitignore ignores .env* except this file.

# --- Netlify, Production context ---
# CONVEX_DEPLOY_KEY is build-only. The others must be available to Functions and Edge
# (proxy.ts calls Clerk; /api/cloudinary/sign signs uploads).
# NEXT_PUBLIC_* values are inlined at build time. `npx convex deploy` also injects
# the production NEXT_PUBLIC_CONVEX_URL into the production build.

CONVEX_DEPLOY_KEY=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Public https origin, no trailing slash. Invitations redirect to ${NEXT_PUBLIC_APP_URL}/sign-up.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Distinct from local uploads, for example hospitality-prod.
CLOUDINARY_UPLOAD_FOLDER=

# --- Convex production deployment (npx convex env set --prod) ---
# Convex functions do not read Netlify environment variables.
# NEXT_PUBLIC_CLERK_JWT_ISSUER_DOMAIN is the Clerk Frontend API URL (convex/auth.config.ts).
# CLERK_WEBHOOK_SECRET is the Svix signing secret for /clerk-users-webhook (convex/http.ts).

NEXT_PUBLIC_CLERK_JWT_ISSUER_DOMAIN=
CLERK_WEBHOOK_SECRET=
